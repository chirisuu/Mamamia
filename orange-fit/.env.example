# ORANGE FIT — variables de entorno
# Copia este archivo a .env.local (local) o cárgalas en tu hosting. Nunca subas valores reales al repo.
# Solo las NEXT_PUBLIC_* llegan al navegador; todas las demás son exclusivas del servidor.
# Si falta una integración, la app lo dice ("pendiente de configurar") y su API responde 503: nada se simula.

# ---------------------------------------------------------------- Sitio
# URL pública (enlaces de correos, OAuth, sitemap, imágenes OG). Local: http://localhost:3000
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Nombre por defecto. El nombre vigente se cambia desde /admin/configuracion (tabla app_settings).
NEXT_PUBLIC_APP_NAME=ORANGE FIT

# ---------------------------------------------------------------- Supabase (obligatorio)
# Local: los imprime `npx supabase start`. Producción: Project Settings → API.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
# Clave pública (anon o publishable). También se acepta NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY.
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Service role (o SUPABASE_SECRET_KEY): eliminar cuenta, webhooks de pago, importador USDA, cron y
# métricas de admin. Sin ella esas funciones responden 503. NUNCA con prefijo NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# ---------------------------------------------------------------- Acceso con Google (opcional)
# "true" muestra el botón. Además hay que activar el proveedor Google en Supabase Auth
# (en local: [auth.external.google] en supabase/config.toml usa estas dos variables).
NEXT_PUBLIC_AUTH_GOOGLE_ENABLED=false
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ---------------------------------------------------------------- IA (Claude de Anthropic)
# Registro por foto, voz y texto, y asistente. Sin clave: 503 AI_NOT_CONFIGURED y la UI lo dice.
ANTHROPIC_API_KEY=
# Modelos por tarea (opcional; por defecto claude-opus-5-5).
AI_MODEL_VISION=claude-opus-5-5
AI_MODEL_TEXT=claude-opus-5-5
AI_MODEL_CHAT=claude-opus-5-5

# Transcripción de voz en el servidor (opcional). "none" usa solo el dictado del navegador.
TRANSCRIPTION_PROVIDER=none
OPENAI_API_KEY=
# Modelo de transcripción (opcional; ver src/lib/ai/transcription.ts).
OPENAI_TRANSCRIPTION_MODEL=

# ---------------------------------------------------------------- Pagos
# Stripe: clave secreta y secreto del webhook (/api/billing/webhooks/stripe). Los price IDs de Stripe
# se cargan por plan en /admin/planes (plan_prices.stripe_price_id), no aquí.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Mercado Pago: access token y clave secreta de notificaciones (/api/billing/webhooks/mercadopago).
# Además hay que encenderlo en /admin/configuracion (la semilla trae payments_mercadopago=false).
MERCADOPAGO_ACCESS_TOKEN=
MERCADOPAGO_WEBHOOK_SECRET=

# ---------------------------------------------------------------- Base de alimentos (opcional)
# USDA FoodData Central, para el importador de /admin/alimentos/importar. Clave gratuita en api.data.gov.
FDC_API_KEY=

# ---------------------------------------------------------------- Notificaciones push (opcional)
# Genera el par con: npx web-push generate-vapid-keys
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# mailto: o https: de contacto del remitente, p. ej. mailto:soporte@tudominio.pe
VAPID_SUBJECT=

# ---------------------------------------------------------------- Tareas programadas
# Protege GET /api/cron/reminders (Authorization: Bearer <CRON_SECRET>). Mínimo 16 caracteres.
# Genera uno con: openssl rand -hex 32
CRON_SECRET=

# ---------------------------------------------------------------- Desarrollo
# Registra el service worker también en `next dev` (por defecto solo en producción).
NEXT_PUBLIC_ENABLE_SW=false
